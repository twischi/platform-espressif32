{
  "name": "espressif32",
  "title": "Espressif 32",
  "description": "ESP32 is a series of low-cost, low-power system on a chip microcontrollers with integrated Wi-Fi and Bluetooth. ESP32 integrates an antenna switch, RF balun, power amplifier, low-noise receive amplifier, filters, and power management modules.",
  "homepage": "https://espressif.com/",
  "license": "Apache-2.0",
  "keywords": [
    "dev-platform",
    "Wi-Fi",
    "Bluetooth",
    "Xtensa",
    "RISC-V"
  ],
  "engines": {
    "platformio": ">=6.1.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/twischi/platform-espressif32.git"
  },
  "version": "2024.11.24",
  "frameworks": {
    "arduino": {
      "script": "builder/frameworks/arduino.py"
    },
    "espidf": {
      "package": "framework-espidf",
      "script": "builder/frameworks/espidf.py"
    }
  },
  "packages": {
    "framework-arduinoespressif32": {
      "type": "framework",
      "description": "Provides the framework to use the Adruiono for ESP32 series.",
      "optional": true,
      "owner": "twischi",
      "version": "https://github.com/twischi/platform-espressif32/releases/download/IDF_v5.3.1-AR_3.1.0/framework-arduinoespressif32-IDF_v5.3.1-AR_3.1.0-esp32-esp32c3-esp32h2-esp32s3.tar.gz"
    },
    "framework-arduinoespressif32-libs": {
      "type": "framework",
      "description": "This package contains the Arduino libraries for ESP32 mcu's It was build using espressif's esp32-arduino-lib-builder",
      "optional": false,
      "owner": "twischi",
      "version": "https://github.com/twischi/platform-espressif32/releases/download/IDF_v5.3.1-AR_3.1.0/framework-arduinoespressif32-libs-IDF_v5.3.1-AR_3.1.0-esp32-esp32c3-esp32h2-esp32s3.tar.gz"
    },
    "framework-espidf": {
      "type": "framework",
      "description": "Package is ESP-IDF download. Exaclty this version is used for for building of cores and libraries.",
      "optional": true,
      "owner": "espressif",
      "version": "https://github.com/espressif/esp-idf/releases/download/v5.3.1/esp-idf-v5.3.1.zip"
    },
    "toolchain-xtensa-esp-elf": {
      "type": "toolchain",
      "optional": true,
      "owner": "platformio",
      "version": "13.2.0+20240530"
    },
    "toolchain-riscv32-esp": {
      "type": "toolchain",
      "optional": true,
      "owner": "platformio",
      "version": "13.2.0+20240530"
    },
    "toolchain-esp32ulp": {
      "type": "toolchain",
      "optional": true,
      "owner": "platformio",
      "version": "~1.23800.0"
    },
    "tool-xtensa-esp-elf-gdb": {
      "type": "debugger",
      "optional": true,
      "owner": "platformio",
      "version": "14.2.0+20240403"
    },
    "tool-riscv32-esp-elf-gdb": {
      "type": "debugger",
      "optional": true,
      "owner": "platformio",
      "version": "14.2.0+20240403"
    },
    "tool-openocd-esp32": {
      "type": "debugger",
      "optional": true,
      "owner": "platformio",
      "version": "2.1200.20230419"
    },
    "tool-esptoolpy": {
      "type": "uploader",
      "owner": "pioarduino",
      "version": "https://github.com/pioarduino/esptool/releases/download/v4.8.1.1/esptool.zip"
    },
    "tool-dfuutil-arduino": {
      "type": "uploader",
      "optional": true,
      "owner": "platformio",
      "version": "~1.11.0"
    },
    "tool-mklittlefs": {
      "type": "uploader",
      "optional": true,
      "owner": "platformio",
      "version": "~2.0.0"
    },
    "tool-mkspiffs": {
      "type": "uploader",
      "optional": true,
      "owner": "platformio",
      "version": "~2.230.0"
    },
    "tool-mkfatfs": {
      "type": "uploader",
      "optional": true,
      "owner": "platformio",
      "version": "~2.0.0"
    },
    "tool-cmake": {
      "optional": true,
      "owner": "platformio",
      "version": "~3.21.0"
    },
    "tool-ninja": {
      "optional": true,
      "owner": "platformio",
      "version": "^1.7.0"
    }
  }
}
